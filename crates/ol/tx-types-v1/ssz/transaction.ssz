import strata_acct_types
import strata_identifiers
import strata_predicate

import proofs

GAM_MAX_PAYLOAD_LEN = 1 << 16

SAU_MAX_PROCESSED_MESSAGES = 1 << 16
SAU_MAX_TYPE_LEDGER_REFS = 255

### Max extra data bytes
SAU_MAX_EXTRA_DATA_BYTES = 1024

# ====================
# GAM tx types
# ====================

### Generic account message payload.
class GamTxPayloadV1(Container):
    ### Target account ID.
    target: strata_acct_types.AccountId

# ====================
# Snark account update tx types
# ====================

### The new state of the snark account.
class SauTxProofStateV1(Container):
    new_next_msg_idx: uint64
    inner_state_root: Bytes32

### Optional rotation of the account's update predicate key.
###
### Empty for ordinary updates.  Set when the update consumes an admin
### predicate-update message from its inbox, committing to the key that
### verifies every later update.
###
### This is a StableContainer because Optional fields are only allowed in
### StableContainers, not plain Containers, so we need this wrapper to make
### the predicate optional.  Capacity 8 costs nothing extra since the
### presence bitvector pads to a full byte anyway, and the spare slots let
### future optional fields slot in without changing the encoding of
### existing data.
#~# derive: std::default::Default
class SauTxNewPredicateV1(StableContainer[8]):
    #~# external_kind: container
    predicate: Optional[strata_predicate.PredicateKey]

### Description of the precise "update" being made to the account.
class SauTxUpdateDataV1(Container):
    seq_no: uint64
    proof_state: SauTxProofStateV1
    extra_data: List[uint8, SAU_MAX_EXTRA_DATA_BYTES]

    ### New update predicate declared by this update, if it rotates the key.
    new_predicate: SauTxNewPredicateV1

### References to other accessible ledger accumulators.
class SauTxLedgerRefsV1(StableContainer[16]):
    #~# external_kind: container
    l1_block_ref_claims: Optional[proofs.ClaimListV1]

### Description of a snark account changes and other constraint checks we need
### to check.
class SauTxOperationDataV1(Container):
    update_data: SauTxUpdateDataV1

    #~# external_kind: container
    messages: List[strata_acct_types.MessageEntry, SAU_MAX_PROCESSED_MESSAGES]

    ledger_refs: SauTxLedgerRefsV1

### Snark account update payload.
class SauTxPayloadV1(Container):
    ### Target account ID.
    target: strata_acct_types.AccountId

    ### Snark account update data.
    operation_data: SauTxOperationDataV1

# ====================
# General tx structural types
# ====================

### Additional constraints that we can place on a transaction.
#~# derive: std::default::Default
class TxConstraintsV1(StableContainer[8]):
    ### Minimum slot for inclusion
    min_slot: Optional[strata_identifiers.Slot]

    ### Maximum slot for inclusion
    max_slot: Optional[strata_identifiers.Slot]

### Transaction payload union.
class TransactionPayloadV1(Union):
    GenericAccountMessage: GamTxPayloadV1
    SnarkAccountUpdate: SauTxPayloadV1

### Data within the transaction.
###
### This is what we compute the txid from.
class OLTransactionDataV1(Container):
    ### Transaction payload (enum variant)
    payload: TransactionPayloadV1

    ### Additional transaction validity conditions.
    constraints: TxConstraintsV1

    ### External effects of the transaction.
    #~# external_kind: container
    effects: strata_acct_types.TxEffects

### Proof data we provide alongside the tx.
###
### This does not impact the txid since it's at partially malleable by design.
class TxProofsV1(StableContainer[8]):
    ### Satisfiers for predicate checks.
    predicate_satisfiers: Optional[proofs.ProofSatisfierListV1]

    ### Proofs for all accumulators queried by the transactions.
    ###
    ### The order is dependent on the tx.
    accumulator_proofs: Optional[proofs.RawMerkleProofListV1]

### Transaction container.
###
### This is what we compute the wtxid from.
class OLTransactionV1(Container):
    ### Transaction data itself.  Used to compute txid.
    data: OLTransactionDataV1

    ### Various proofs which might be modified.
    proofs: TxProofsV1
