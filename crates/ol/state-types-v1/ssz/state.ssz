import strata_acct_types
import strata_identifiers
import strata_asm_manifest_types
import strata_predicate
import strata_snark_acct_types
import strata_ol_state_types
import epochal
import global
import intraepoch
import protocol
import account
import snark_account

MAX_LEDGER_ACCOUNTS = 1 << 24
MAX_ACCOUNT_SERIALS = 1 << 24

### Buffers one full epoch's manifest budget under the expected heavy-manifest case:
### 2048 ASM manifests with up to 128 logs each, i.e. 2048 * 128 = 1 << 18 pending logs.
MAX_PENDING_ASM_LOGS = 1 << 18

### Top-level OL state.
###
### Field positions and capacities are permanent protocol choices. Append fields;
### never renumber or reuse retired positions. Public Rust domain types enforce
### mandatory V1 fields during decoding and store those fields directly.
### Nested fields use those types so ordinary decoding checks them too.
class OLStateV1Ssz(StableContainer[32]):
    ### Epochal state
    epoch: Optional[epochal.EpochalStateV1]

    ### Global state
    global: Optional[global.GlobalStateV1]

    ### Transient state that exists within an epoch.
    ###
    ### Reset at the end.
    intraepoch: Optional[intraepoch.IntraepochStateV1]

    ### Ledger accounts table
    ledger: Optional[TsnlLedgerAccountsTableV1]

    ### Dormant protocol versions; both remain V1 until upgrade handling is added.
    protocol_state: Optional[protocol.ProtocolStateV1]

### Committed OL protocol versions with reserved extension capacity.
class ProtocolStateV1Ssz(StableContainer[8]):
    active_version: Optional[strata_ol_state_types.OLSpecId]
    expected_version: Optional[strata_ol_state_types.OLSpecId]

### Ledger accounts table
class TsnlLedgerAccountsTableV1(Container):
    ### Sorted list of account entries
    accounts: List[TsnlAccountEntryV1, MAX_LEDGER_ACCOUNTS]

### Ledger account entry
class TsnlAccountEntryV1(Container):
    ### Account ID
    id: strata_acct_types.AccountId

    ### Account state
    state: account.OLAccountStateV1

### Account state with five reserved positions for future fields.
class OLAccountStateV1Ssz(StableContainer[8]):
    ### Account serial number
    serial: Optional[strata_identifiers.AccountSerial]

    ### Account balance
    balance: Optional[strata_acct_types.BitcoinAmount]

    ### Account type-specific state
    state: Optional[OLAccountTypeStateV1]

### Account type state as union
class OLAccountTypeStateV1(Union):
    ### Empty account
    Empty

    ### Snark account
    Snark: snark_account.OLSnarkAccountStateV1

### Snark account state with twelve reserved positions for future fields.
class OLSnarkAccountStateV1Ssz(StableContainer[16]):
    ### Verifying Key used to verify updates
    #~# external_kind: container
    update_vk: Optional[strata_predicate.PredicateKey]

    ### Sequence number
    seqno: Optional[strata_snark_acct_types.Seqno]

    ### Proof state
    proof_state: Optional[ProofStateV1]

    ### Inbox MMR
    #~# external_kind: container
    inbox_mmr: Optional[strata_acct_types.Mmr64]


### Proof state for snark accounts
class ProofStateV1(Container):
    ### Inner state root commitment
    inner_state_root: Bytes32

    ### Next message read index
    next_msg_read_idx: uint64


class IntraepochStateV1Ssz(StableContainer[8]):
    #~# external_kind: container
    pending_asm_logs: Optional[List[PendingAsmLogEntryV1, MAX_PENDING_ASM_LOGS]]


class PendingAsmLogEntryV1(Container):
    height: uint32
    #~# external_kind: container
    log: strata_asm_manifest_types.AsmLogEntry


### Epoch-level state
class EpochalStateV1Ssz(StableContainer[16]):
    ### Total funds in the ledger
    total_ledger_funds: Optional[strata_acct_types.BitcoinAmount]

    ### Current epoch number
    cur_epoch: Optional[strata_identifiers.Epoch]

    ### Last L1 block commitment
    #~# external_kind: container
    last_l1_block: Optional[strata_identifiers.L1BlockCommitment]

    ### Checkpointed epoch commitment
    #~# external_kind: container
    checkpointed_epoch: Optional[strata_identifiers.EpochCommitment]

    ### L1 block refs MMR
    ###
    ### Indices into this MMR are L1 block heights. At genesis the MMR is
    ### prefilled with dummy sentinel values of `[0xff, 32]`, so the first
    ### real appended L1 block ref (for genesis_l1_height + 1) lands at the
    ### correct height-indexed position.
    #~# external_kind: container
    l1_block_refs_mmr: Optional[strata_acct_types.Mmr64]

### Global state tracking current slot
class GlobalStateV1Ssz(StableContainer[16]):
    ### Current slot number
    cur_slot: Optional[strata_identifiers.Slot]

    ### Next available serial we can assign to an account.
    next_avail_serial: Optional[uint64]

    ### Funds in limbo, measured in satoshis.
    limbo_funds_sats: Optional[uint64]
